# Copy this file to `.env` and fill in what you use. `.env` is git-ignored.
# The app runs WITHOUT any key — only the LLM recommendation step needs one.

# --- LLM provider (only the one you use needs a key) ----------------------
# OpenRouter (default, OpenAI-compatible). Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Free-tier model slugs end in ":free" and change over time; see openrouter.ai/models
ASSAY_OPENROUTER_MODEL=tencent/hy3:free

# Anthropic (only if you select provider=anthropic)
# ANTHROPIC_API_KEY=

# Local Ollama (only if you select provider=ollama). In Docker point at the host:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- API settings (optional; sensible defaults) ---------------------------
# ASSAY_LOG_LEVEL=INFO
# ASSAY_CORS_ORIGINS=http://localhost:8501,http://localhost:8502
# ASSAY_MAX_UPLOAD_BYTES=10485760
# ASSAY_PROVIDER=openrouter
